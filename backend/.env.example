APP_NAME=Autonomous Research Analyst API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://research_user:research_password@localhost:5433/research_analyst
REDIS_URL=redis://localhost:6379/0

LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.7-flash
LLM_TIMEOUT=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=30

TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5